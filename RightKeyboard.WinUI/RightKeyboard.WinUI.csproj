<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RightKeyboard.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\RightKeyboard\ico_input0002.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RightKeyboard.Shared\RightKeyboard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\RightKeyboard\ico_input0002.ico" Link="Assets\RightKeyboard.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    `dotnet publish` no conserva estos recursos generados para la aplicación WinUI
    no empaquetada. Sin ellos XamlControlsResources no puede resolver el tema completo
    en la salida distribuida, aunque la carpeta de compilación sí se vea correctamente.
  -->
  <Target Name="CopyWinUiGeneratedResourcesToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <WinUiAppXbf>$(TargetDir)App.xbf</WinUiAppXbf>
      <WinUiAppPri>$(TargetDir)$(AssemblyName).pri</WinUiAppPri>
    </PropertyGroup>

    <Error Condition="!Exists('$(WinUiAppXbf)')"
           Text="No se encontró el recurso WinUI generado: $(WinUiAppXbf)" />
    <Error Condition="!Exists('$(WinUiAppPri)')"
           Text="No se encontró el índice de recursos WinUI generado: $(WinUiAppPri)" />
    <Copy SourceFiles="$(WinUiAppXbf);$(WinUiAppPri)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
